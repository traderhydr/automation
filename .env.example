# --- Telegram reading (private channel) via your user account (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=          # generate once with: python -m src.make_session
PRIVATE_CHANNEL=zoro gem trades   # channel TITLE, @username, or numeric id (-100...). Title works if your account is a member

# --- Telegram publishing (public channel) via a bot that is ADMIN of the public channel
TG_BOT_TOKEN=
PUBLIC_CHANNEL=@ZoroTradez   # one or several, comma separated: @a,-1001234567890 (bot must be ADMIN of each)
# Optional routing (default: every PUBLIC_CHANNEL gets everything):
#CHANNELS_REPORTS=@a,-100...    daily/weekly/monthly/yearly results
#CHANNELS_SIGNALS=@a            free sample signals
#CHANNELS_OUTLOOK=@a,@b         BTC bounce-vs-dump chart

# --- AI (captions + fallback trade parsing)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Optional platforms (leave blank to skip)
DISCORD_WEBHOOK_URL=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Branding / behaviour
CHANNEL_NAME=Trader Hydr
LOGO_IMAGE=assets/logo.jpg
JOIN_LINK=https://t.me/your_public_channel
TIMEZONE=Asia/Karachi        # GMT+5, no daylight saving. Report days run 00:00-24:00 GMT+5
DRY_RUN=1                   # 1 = build report, don't post anywhere
MARGIN_PER_TRADE_PCT=100  # % of account used as margin per trade (Cornix % are ROI on margin incl. leverage). e.g. 2 => report account return
PNL_NOTE=                # label printed on charts; auto if blank

# --- Free-channel teaser (private channel is paid)
PUBLIC_SIGNALS_PER_DAY=2      # random signals per day shown publicly (0 = every signal)
PUBLIC_SIGNAL_DELAY_MIN=0     # 0 = post free samples immediately; set e.g. 30 to delay them
PUBLIC_WINDOW_START=8         # local hours in which the random picks are drawn
PUBLIC_WINDOW_END=22
RANDOM_SECRET=                # any random text; keeps the daily random times unpredictable

# --- Your links (blank = skipped). Shown under every post; referral ones get an automatic disclosure line.
TELEGRAM_LINK=https://t.me/ZoroTradez     # FREE public channel
PREMIUM_LINK=https://t.me/Hydrzoro      # people DM you to join premium (never post an open invite to the private channel)
PREMIUM_HANDLE=@Hydrzoro
CONTACT_LINK=https://t.me/Hydrzoro
X_LINK=https://x.com/Trader_Hydr
YOUTUBE_LINK=https://youtube.com/@traderhydr
BLOFIN_REF_LINK=https://partner.blofin.com/d/HYDR
COPY_TRADING_LINK=https://blofin.com/copy-trade/details/50803037201?module=futures
BINANCE_CREATOR_LINK=https://app.binance.com/uni-qr/cpro/ZenithX?l=en&r=VUUMW0NT&uc=app_square_share_link&us=copylink
